flowchart TB
  OPEN["<b>State at year-end y−1</b><br/>facility slices with their allowances"]:::neutral
  PERF["<b>Performing slices</b><br/>one per grade G1…G10"]:::step
  S3IN["<b>S3 slices</b><br/>original and earlier cohorts"]:::s3
  M["<b>× PiT matrix M(y)</b><br/>segment · country · scenario"]:::step
  NEWG["<b>Grade slices at y</b><br/>stage from the SICR line"]:::step
  NEWD["<b>New S3 cohorts</b><br/>D column · entry year y<br/>origin stage S1 or S2"]:::s3
  CARRY["<b>Carried unchanged</b><br/>no cure, sale<br/>or write-off"]:::s3
  ECL["<b>R8 · provisions at y</b><br/>S1 12-month · S2 lifetime · S3 floored"]:::step
  CHG["<b>R9 · charge(y)</b><br/>closing − opening"]:::step
  OPEN --> PERF --> M
  OPEN --> S3IN --> CARRY
  M --> NEWG
  M --> NEWD
  NEWG --> ECL
  NEWD --> ECL
  CARRY --> ECL
  ECL --> CHG
  CHG -. "opening of y+1" .-> OPEN
  classDef oneoff fill:#e3f5ee,stroke:#1baf7a,stroke-width:1.5px,color:#0b0b0b
  classDef step fill:#e6effb,stroke:#2a78d6,stroke-width:1.5px,color:#0b0b0b
  classDef cash fill:#fdeee6,stroke:#eb6834,stroke-width:1.5px,color:#0b0b0b
  classDef file fill:#fbf5e3,stroke:#c98500,stroke-width:1.5px,color:#0b0b0b
  classDef block fill:#fdecec,stroke:#e34948,stroke-width:1.5px,color:#0b0b0b
  classDef s3 fill:#dde5f1,stroke:#104281,stroke-width:1.5px,color:#0b0b0b
  classDef neutral fill:#f5f5f3,stroke:#898781,stroke-width:1.5px,color:#0b0b0b
  classDef tab fill:#ffffff,stroke:#898781,stroke-width:1px,color:#0b0b0b
