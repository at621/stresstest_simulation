flowchart TB
  subgraph ING["Open and ingest"]
    direction LR
    R1["<b>R1</b> · open the run<br/>lineage/"]:::step
    R2["<b>R2</b> · load inputs<br/>ingest/"]:::step
    R3["<b>R3</b> · validate, route<br/>validate/"]:::step
    R1 --> R2 --> R3
  end
  subgraph PREP["Prepare (both scenarios)"]
    direction LR
    R4["<b>R4</b> · Z-scores<br/>scenario/"]:::step
    R5["<b>R5</b> · cash flows<br/>cashflows/"]:::cash
    R6["<b>R6</b> · parameters<br/>params/"]:::step
    R4 --> R5 --> R6
  end
  subgraph LOOP["Per scenario, baseline first"]
    direction TB
    D["<b>R8</b> · end-2026 valuation (diagnostic)"]:::step
    subgraph YEARS["Per year, 2027 to 2029"]
      direction LR
      R7["<b>R7</b> · project<br/>projection/"]:::step
      R8["<b>R8</b> · provisions<br/>ecl/"]:::step
      R9["<b>R9</b> · charges<br/>accounting/"]:::step
      R7 --> R8 --> R9
    end
    D --> YEARS
  end
  subgraph OUT["Report and seal"]
    direction LR
    BLK["BlockingError<br/>in R2–R10"]:::block
    R10["<b>R10</b> · report<br/>report/"]:::step
    R11["<b>R11</b> · seal<br/>lineage/"]:::step
    R10 --> R11
    BLK -. "sealed BLOCKED" .-> R11
  end
  ING --> PREP --> LOOP --> OUT
  classDef oneoff fill:#e3f5ee,stroke:#1baf7a,stroke-width:1.5px,color:#0b0b0b
  classDef step fill:#e6effb,stroke:#2a78d6,stroke-width:1.5px,color:#0b0b0b
  classDef cash fill:#fdeee6,stroke:#eb6834,stroke-width:1.5px,color:#0b0b0b
  classDef file fill:#fbf5e3,stroke:#c98500,stroke-width:1.5px,color:#0b0b0b
  classDef block fill:#fdecec,stroke:#e34948,stroke-width:1.5px,color:#0b0b0b
  classDef s3 fill:#dde5f1,stroke:#104281,stroke-width:1.5px,color:#0b0b0b
  classDef neutral fill:#f5f5f3,stroke:#898781,stroke-width:1.5px,color:#0b0b0b
  classDef tab fill:#ffffff,stroke:#898781,stroke-width:1px,color:#0b0b0b
